{
  "extends": ["stylelint-config-standard-scss", "stylelint-prettier/recommended"],
  "rules": {
    "alpha-value-notation": null,
    "at-rule-no-vendor-prefix": null,
    "color-function-notation": null,
    "custom-property-pattern": null,
    "declaration-block-no-duplicate-properties": [
      true,
      {
        "ignore": ["consecutive-duplicates-with-different-values"]
      }
    ],
    "declaration-block-no-redundant-longhand-properties": null,
    "font-family-no-missing-generic-family-keyword": null,
    "declaration-block-no-shorthand-property-overrides": null,
    "keyframes-name-pattern": null,
    "max-nesting-depth": null,
    "no-descending-specificity": null,
    "no-empty-source": true,
    "property-no-vendor-prefix": null,
    "property-no-unknown": [
      true,
      {
        "ignoreSelectors": [":export", ":global"]
      }
    ],
    "scss/at-extend-no-missing-placeholder": null,
    "scss/at-mixin-pattern": null,
    "scss/at-rule-no-unknown": true,
    "scss/dollar-variable-pattern": null,
    "scss/double-slash-comment-whitespace-inside": null,
    "scss/double-slash-comment-empty-line-before": null,
    "scss/operator-no-unspaced": true,
    "selector-class-pattern": null,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ],
    "comment-empty-line-before": null,
    "declaration-empty-line-before": null,
    "rule-empty-line-before": null,
    "declaration-property-value-disallowed-list": [
      {
        "/^(color|background|background-color|border|border-(top|right|bottom|left|block|inline|block-start|block-end|inline-start|inline-end)|border(-(top|right|bottom|left|block|inline|block-start|block-end|inline-start|inline-end))?-color|outline|outline-color|fill|stroke|box-shadow|text-shadow|caret-color|accent-color|text-decoration-color|column-rule|column-rule-color)$/": [
          "/#[0-9a-fA-F]{3,8}\\b/",
          "/\\brgba?\\(/"
        ],
        "/^(font-size|border-radius|border-(top|bottom)-(left|right)-radius|border-(start|end)-(start|end)-radius|gap|row-gap|column-gap|padding|padding-(top|right|bottom|left|block|inline|block-start|block-end|inline-start|inline-end)|margin|margin-(top|right|bottom|left|block|inline|block-start|block-end|inline-start|inline-end))$/": [
          "/(?<![\\w.-])(?!(?:0|1)px\\b)\\d*\\.?\\d+px\\b/"
        ]
      },
      {
        "message": "Use a token from app/styles/globals.css (hex and rgb() colours, and px sizes other than 0 and 1px, are not allowed here)"
      }
    ]
  }
}
